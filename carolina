const startDate = new Date("2025-12-25T16:05:00");

function updateCounter() {
  const now = new Date();
  let diff = now - startDate;

  if (diff < 0) {
    document.getElementById("counter").textContent = "Aún no comienza...";
    return;
  }

  const totalSeconds = Math.floor(diff / 1000);
  const days = Math.floor(totalSeconds / 86400);
  const hours = Math.floor((totalSeconds % 86400) / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = totalSeconds % 60;

  document.getElementById("counter").textContent =
    `${days} días ${String(hours).padStart(2,"0")} horas ${String(minutes).padStart(2,"0")} minutos ${String(seconds).padStart(2,"0")} segundos`;
}

updateCounter();
setInterval(updateCounter, 1000);

const card = document.getElementById("card");
const surprise = document.getElementById("surprise");

surprise.addEventListener("click", () => {
  card.classList.add("revealed");
  surprise.textContent = "Te quiero, Carolina ❤️";
  surprise.disabled = true;

  // Lluvia de corazones
  for (let i = 0; i < 90; i++) {
    setTimeout(createHeart, i * 45);
  }

  // Intenta reproducir el audio si el navegador lo permite.
  const music = document.getElementById("music");
  music.play().catch(() => {});
});

function createHeart() {
  const heart = document.createElement("div");
  heart.className = "falling-heart";
  heart.textContent = Math.random() > 0.35 ? "❤️" : "🤍";
  heart.style.left = Math.random() * 100 + "vw";
  heart.style.setProperty("--drift", (Math.random() * 220 - 110) + "px");
  heart.style.animationDuration = (3 + Math.random() * 4) + "s";
  heart.style.fontSize = (14 + Math.random() * 24) + "px";
  document.body.appendChild(heart);

  setTimeout(() => heart.remove(), 8000);
}
